rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasAdminClaim() {
      return signedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isAdmin() {
      return hasAdminClaim()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true
        );
    }

    function isActiveOwner(userId) {
      return isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.isActive == true;
    }

    function validUserProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'isActive',
          'subscription',
          'subscriptionExpiresAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['user', 'admin']
        && (
          (request.resource.data.role == 'admin' && isAdmin())
          || (request.resource.data.role == 'user' && request.resource.data.isActive == false)
        );
    }

    function validOwnerAutoDeactivate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['isActive'])
        && resource.data.isActive == true
        && request.resource.data.isActive == false;
    }

    function canReadUserData(userId) {
      return isActiveOwner(userId) || isAdmin();
    }

    function optionalUserIdMatches(userId) {
      return !request.resource.data.keys().hasAny(['userId'])
        || request.resource.data.userId == userId;
    }

    function storedUserIdMatches(userId) {
      return !resource.data.keys().hasAny(['userId'])
        || resource.data.userId == userId;
    }

    function isText(field, maxLength) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLength;
    }

    function optionalText(field, maxLength) {
      return !request.resource.data.keys().hasAny([field])
        || isText(field, maxLength);
    }

    function optionalNullableText(field, maxLength) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] == null
        || isText(field, maxLength);
    }

    function softDeleteMetadataValid() {
      return optionalNullableText('deletedAt', 40)
        && optionalNullableText('deletedBy', 160)
        && optionalNullableText('deletedReason', 500)
        && optionalNullableText('resetAt', 40)
        && optionalNullableText('resetId', 160);
    }

    function isNumberInRange(field, minValue, maxValue) {
      return request.resource.data[field] is number
        && request.resource.data[field] >= minValue
        && request.resource.data[field] <= maxValue;
    }

    function optionalNumberInRange(field, minValue, maxValue) {
      return !request.resource.data.keys().hasAny([field])
        || isNumberInRange(field, minValue, maxValue);
    }

    function optionalBool(field) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] is bool;
    }

    function optionalList(field, maxLength) {
      return !request.resource.data.keys().hasAny([field])
        || (request.resource.data[field] is list && request.resource.data[field].size() <= maxLength);
    }

    function optionalMap(field) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] is map;
    }

    function paymentStatusValid() {
      return !request.resource.data.keys().hasAny(['statusPagamento'])
        || request.resource.data.statusPagamento in ['Pago', 'Pendente', 'Parcial'];
    }

    function maintenanceStatusValid() {
      return request.resource.data.status in ['OK', 'WARNING', 'OVERDUE'];
    }

    function cashLaunchStatusValid() {
      return request.resource.data.status in ['Em Lancamento', 'Finalizado', 'Pendente'];
    }

    function requiredBaseFields(userId, requiredKeys, allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys)
        && request.resource.data.keys().hasAll(requiredKeys)
        && request.resource.data.userId == userId;
    }

    function clientShape(userId) {
      return requiredBaseFields(userId, [
          'userId',
          'name',
          'bikeModel',
          'contact',
          'lastMaintenanceDate',
          'nextMaintenanceDate',
          'recurrenceDays',
          'status',
          'createdAt'
        ], clientKeys())
        && isText('name', 120)
        && optionalText('fullName', 160)
        && optionalText('document', 32)
        && isText('bikeModel', 120)
        && isText('contact', 60)
        && optionalText('email', 160)
        && optionalText('vehiclePlate', 20)
        && optionalText('oilType', 80)
        && optionalNumberInRange('oilPrice', 0, 10000000)
        && optionalNumberInRange('mileageKm', 0, 2000000)
        && isText('lastMaintenanceDate', 40)
        && isText('nextMaintenanceDate', 40)
        && isNumberInRange('recurrenceDays', 0, 3650)
        && maintenanceStatusValid()
        && optionalBool('isRecurringRevenue')
        && optionalBool('notificacao_enviada')
        && optionalText('notificacaoStatus', 40)
        && optionalText('lastServiceType', 120)
        && optionalNumberInRange('lastServiceValue', 0, 10000000)
        && optionalText('lastServiceNotes', 5000)
        && isText('createdAt', 40)
        && optionalText('lastAlertDate', 40)
        && optionalNumberInRange('serviceValue', 0, 10000000)
        && paymentStatusValid()
        && optionalNumberInRange('valorPago', 0, 10000000)
        && optionalNumberInRange('saldoDevedor', 0, 10000000)
        && optionalMap('automation')
        && softDeleteMetadataValid();
    }

    function maintenanceShape(userId) {
      return requiredBaseFields(userId, [
          'userId',
          'clientId',
          'clientName',
          'bikeModel',
          'date',
          'serviceType',
          'serviceValue',
          'isRecurringRevenue',
          'notes'
        ], maintenanceKeys())
        && isText('clientId', 160)
        && isText('clientName', 120)
        && isText('bikeModel', 120)
        && isText('date', 40)
        && optionalText('oilType', 80)
        && optionalNumberInRange('oilPrice', 0, 10000000)
        && isText('serviceType', 120)
        && isNumberInRange('serviceValue', 0, 10000000)
        && request.resource.data.isRecurringRevenue is bool
        && isText('notes', 5000)
        && paymentStatusValid()
        && optionalNumberInRange('valorPago', 0, 10000000)
        && optionalNumberInRange('saldoDevedor', 0, 10000000)
        && softDeleteMetadataValid();
    }

    function warrantyShape(userId) {
      return requiredBaseFields(userId, [
          'userId',
          'clientName',
          'serviceType',
          'serviceDescription',
          'serviceValue',
          'serviceDate',
          'durationMonths',
          'expiryDate',
          'clientPhone',
          'warrantyNumber',
          'createdAt'
        ], warrantyKeys())
        && isText('clientName', 120)
        && isText('serviceType', 120)
        && isText('serviceDescription', 5000)
        && isNumberInRange('serviceValue', 0, 10000000)
        && isText('serviceDate', 40)
        && isNumberInRange('durationMonths', 0, 240)
        && isText('expiryDate', 40)
        && isText('clientPhone', 60)
        && isNumberInRange('warrantyNumber', 0, 1000000000)
        && isText('createdAt', 40)
        && softDeleteMetadataValid();
    }

    function appointmentShape(userId) {
      return requiredBaseFields(userId, [
          'userId',
          'clientName',
          'bikeModel',
          'scheduledDate',
          'serviceRequested',
          'completed',
          'createdAt'
        ], appointmentKeys())
        && isText('clientName', 120)
        && isText('bikeModel', 120)
        && isText('scheduledDate', 40)
        && optionalText('address', 240)
        && isText('serviceRequested', 5000)
        && optionalNumberInRange('value', 0, 10000000)
        && request.resource.data.completed is bool
        && isText('createdAt', 40)
        && softDeleteMetadataValid();
    }

    function expenseShape(userId) {
      return requiredBaseFields(userId, [
          'userId',
          'description',
          'amount',
          'paymentMethod',
          'date',
          'createdAt'
        ], expenseKeys())
        && isText('description', 240)
        && optionalText('supplier', 160)
        && isNumberInRange('amount', 0, 10000000)
        && isText('paymentMethod', 80)
        && isText('date', 40)
        && optionalText('note', 5000)
        && isText('createdAt', 40)
        && softDeleteMetadataValid();
    }

    function productShape(userId, productId) {
      return requiredBaseFields(userId, [
          'userId',
          'id',
          'sourceCode',
          'description',
          'ncm',
          'salePrice'
        ], productKeys())
        && isText('id', 160)
        && request.resource.data.id == productId
        && isText('sourceCode', 80)
        && isText('description', 240)
        && optionalText('variation', 160)
        && optionalList('variations', 80)
        && isText('ncm', 20)
        && isNumberInRange('salePrice', 0, 10000000)
        && optionalNumberInRange('stockQuantity', 0, 10000000)
        && optionalNumberInRange('minStockQuantity', 0, 10000000)
        && optionalBool('trackStock')
        && optionalText('importedAt', 40)
        && optionalText('createdAt', 40)
        && optionalText('updatedAt', 40)
        && softDeleteMetadataValid();
    }

    function stockMovementShape(userId) {
      return requiredBaseFields(userId, [
          'userId',
          'productId',
          'productDescription',
          'type',
          'quantity',
          'previousQuantity',
          'nextQuantity',
          'batchId',
          'createdAt'
        ], stockMovementKeys())
        && isText('productId', 160)
        && isText('productDescription', 240)
        && optionalText('sourceCode', 80)
        && optionalText('variationId', 160)
        && optionalText('variation', 160)
        && request.resource.data.type in ['saida_os', 'estorno_os', 'entrada_manual', 'ajuste_manual']
        && isNumberInRange('quantity', 0, 10000000)
        && isNumberInRange('previousQuantity', 0, 10000000)
        && isNumberInRange('nextQuantity', 0, 10000000)
        && optionalText('cashLaunchId', 160)
        && optionalText('cashLaunchOrderNumber', 80)
        && optionalList('itemIds', 200)
        && isText('batchId', 200)
        && optionalText('note', 500)
        && isText('createdAt', 40);
    }

    function cashLaunchShape(userId) {
      return requiredBaseFields(userId, [
          'userId',
          'orderNumber',
          'clientName',
          'status',
          'openingDate',
          'expectedDate',
          'items',
          'merchandiseTotal',
          'servicesTotal',
          'discountTotal',
          'total',
          'createdAt',
          'updatedAt'
        ], cashLaunchKeys())
        && isText('orderNumber', 80)
        && optionalText('clientId', 160)
        && isText('clientName', 120)
        && optionalText('clientDocument', 32)
        && optionalText('clientEmail', 160)
        && optionalText('clientPhone', 60)
        && optionalText('bikeModel', 120)
        && cashLaunchStatusValid()
        && isText('openingDate', 40)
        && isText('expectedDate', 40)
        && optionalText('request', 5000)
        && optionalText('servicesExecuted', 5000)
        && optionalText('observation', 5000)
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200
        && isNumberInRange('merchandiseTotal', 0, 10000000)
        // Prevent saving a finalized or pending O.S. without merchandise
        && (
          request.resource.data.status == 'Em Lancamento'
          || (request.resource.data.items.size() > 0 && request.resource.data.merchandiseTotal > 0)
        )
        && isNumberInRange('servicesTotal', 0, 10000000)
        && isNumberInRange('discountTotal', 0, 10000000)
        && optionalNumberInRange('orderDiscountValue', 0, 10000000)
        && optionalNumberInRange('orderDiscountPercent', 0, 100)
        && isNumberInRange('total', 0, 10000000)
        && optionalBool('invoiced')
        && optionalText('paymentMethod', 40)
        && (
          !request.resource.data.keys().hasAny(['invoiced'])
          || request.resource.data.invoiced != true
          || (
            request.resource.data.keys().hasAny(['paymentMethod'])
            && request.resource.data.paymentMethod in ['Debito', 'Credito', 'Pix', 'Dinheiro']
          )
        )
        && optionalText('fiscalInvoiceId', 160)
        && optionalText('fiscalReference', 160)
        && optionalText('fiscalIssuedAt', 40)
        && optionalMap('manualFiscal')
        && optionalBool('stockDeducted')
        && optionalNullableText('stockDeductedAt', 40)
        && optionalNullableText('stockMovementBatchId', 200)
        && isText('createdAt', 40)
        && isText('updatedAt', 40)
        && softDeleteMetadataValid();
    }

    function cashLaunchUpdateShape(userId) {
      return request.resource.data.userId == userId
        && storedUserIdMatches(userId)
        && isText('orderNumber', 80)
        && optionalText('clientId', 160)
        && isText('clientName', 120)
        && optionalText('clientDocument', 32)
        && optionalText('clientEmail', 160)
        && optionalText('clientPhone', 60)
        && optionalText('bikeModel', 120)
        && cashLaunchStatusValid()
        && isText('openingDate', 40)
        && isText('expectedDate', 40)
        && optionalText('request', 5000)
        && optionalText('servicesExecuted', 5000)
        && optionalText('observation', 5000)
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200
        && isNumberInRange('merchandiseTotal', 0, 10000000)
        && (
          request.resource.data.status == 'Em Lancamento'
          || (request.resource.data.items.size() > 0 && request.resource.data.merchandiseTotal > 0)
        )
        && isNumberInRange('servicesTotal', 0, 10000000)
        && isNumberInRange('discountTotal', 0, 10000000)
        && optionalNumberInRange('orderDiscountValue', 0, 10000000)
        && optionalNumberInRange('orderDiscountPercent', 0, 100)
        && isNumberInRange('total', 0, 10000000)
        && optionalBool('invoiced')
        && optionalText('paymentMethod', 40)
        && (
          !request.resource.data.keys().hasAny(['invoiced'])
          || request.resource.data.invoiced != true
          || (
            request.resource.data.keys().hasAny(['paymentMethod'])
            && request.resource.data.paymentMethod in ['Debito', 'Credito', 'Pix', 'Dinheiro']
          )
        )
        && optionalText('fiscalInvoiceId', 160)
        && optionalText('fiscalReference', 160)
        && optionalText('fiscalIssuedAt', 40)
        && optionalMap('manualFiscal')
        && optionalBool('stockDeducted')
        && optionalNullableText('stockDeductedAt', 40)
        && optionalNullableText('stockMovementBatchId', 200)
        && isText('createdAt', 40)
        && isText('updatedAt', 40)
        && softDeleteMetadataValid();
    }

    function messageLogShape(userId) {
      return requiredBaseFields(userId, [
          'userId',
          'clientId',
          'clientName',
          'phone',
          'channel',
          'status',
          'trigger',
          'message',
          'createdAt'
        ], messageLogKeys())
        && isText('clientId', 160)
        && isText('clientName', 120)
        && optionalText('bikeModel', 120)
        && isText('phone', 60)
        && request.resource.data.channel in ['whatsapp', 'email', 'manual']
        && request.resource.data.status in ['pending', 'opened_whatsapp', 'sent', 'failed']
        && request.resource.data.trigger in ['manual', 'scheduled', 'retry']
        && isText('message', 2000)
        && isText('createdAt', 40)
        && optionalText('sentAt', 40)
        && optionalText('error', 1000)
        && softDeleteMetadataValid();
    }

    function operationalLogShape(userId) {
      return requiredBaseFields(userId, [
          'userId',
          'timestamp',
          'usuario',
          'oficina',
          'acao',
          'resultado'
        ], operationalLogKeys())
        && isText('timestamp', 40)
        && isText('usuario', 160)
        && isText('oficina', 160)
        && request.resource.data.acao in [
          'cliente_criado',
          'cliente_editado',
          'cliente_removido',
          'os_criada',
          'garantia_criada',
          'despesa_criada',
          'receita_criada'
        ]
        && request.resource.data.resultado in ['sucesso', 'salvo_offline', 'erro']
        && optionalText('targetId', 160)
        && optionalMap('details');
    }

    function whatsappAutomationShape(userId) {
      return requiredBaseFields(userId, [
          'userId',
          'enabled',
          'aiEnabled',
          'autoReplyEnabled',
          'appointmentEnabled',
          'createdAt',
          'updatedAt'
        ], whatsappAutomationKeys())
        && request.resource.data.enabled is bool
        && request.resource.data.aiEnabled is bool
        && request.resource.data.autoReplyEnabled is bool
        && request.resource.data.appointmentEnabled is bool
        && isText('createdAt', 40)
        && isText('updatedAt', 40);
    }

    function settingsShape(userId) {
      return request.resource.data.keys().hasOnly([
          'userId',
          'whatsappTemplate',
          'oilTypes',
          'serviceTypes',
          'disabledDefaultServiceTypes',
          'businessEmail',
          'warrantyCategories',
          'businessName',
          'businessPhone',
          'businessWhatsapp',
          'businessInstagram',
          'businessAddress',
          'isProfileComplete',
          'expenses'
        ])
        && optionalUserIdMatches(userId)
        && optionalText('whatsappTemplate', 2000)
        && optionalList('oilTypes', 80)
        && optionalList('serviceTypes', 120)
        && optionalList('disabledDefaultServiceTypes', 120)
        && optionalText('businessEmail', 160)
        && optionalList('warrantyCategories', 80)
        && optionalText('businessName', 160)
        && optionalText('businessPhone', 60)
        && optionalText('businessWhatsapp', 60)
        && optionalText('businessInstagram', 80)
        && optionalText('businessAddress', 240)
        && optionalBool('isProfileComplete')
        && optionalList('expenses', 80);
    }

    function validOwnerCreate(userId, allowedKeys) {
      return isActiveOwner(userId)
        && request.resource.data.keys().hasOnly(allowedKeys)
        && request.resource.data.keys().hasAny(['userId'])
        && request.resource.data.userId == userId;
    }

    function validOwnerUpdate(userId, allowedKeys) {
      return isActiveOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys)
        && optionalUserIdMatches(userId)
        && storedUserIdMatches(userId);
    }

    function softDeleteUpdateKeys() {
      return [
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId',
        'updatedAt'
      ];
    }

    function validOwnerSoftDeleteUpdate(userId) {
      return isActiveOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(softDeleteUpdateKeys())
        && optionalUserIdMatches(userId)
        && storedUserIdMatches(userId)
        && softDeleteMetadataValid()
        && optionalText('updatedAt', 40);
    }

    function validOwnerProductStockUpdate(userId) {
      return isActiveOwner(userId)
        && storedUserIdMatches(userId)
        && optionalUserIdMatches(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity', 'updatedAt'])
        && request.resource.data.stockQuantity is number
        && request.resource.data.stockQuantity >= 0
        && request.resource.data.stockQuantity <= 10000000
        && optionalText('updatedAt', 40);
    }

    function validOwnerStockMovementCreate(userId) {
      return isActiveOwner(userId)
        && request.resource.data.keys().hasOnly(stockMovementKeys())
        && request.resource.data.userId == userId
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 160
        && request.resource.data.productDescription is string
        && request.resource.data.productDescription.size() <= 240
        && request.resource.data.type in ['saida_os', 'estorno_os', 'entrada_manual', 'ajuste_manual']
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= 10000000
        && request.resource.data.previousQuantity is number
        && request.resource.data.previousQuantity >= 0
        && request.resource.data.previousQuantity <= 10000000
        && request.resource.data.nextQuantity is number
        && request.resource.data.nextQuantity >= 0
        && request.resource.data.nextQuantity <= 10000000
        && request.resource.data.batchId is string
        && request.resource.data.batchId.size() <= 200
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;
    }

    function validOwnerCashLaunchFinalizedStockPaymentUpdate(userId) {
      return isActiveOwner(userId)
        && storedUserIdMatches(userId)
        && optionalUserIdMatches(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientId',
          'clientName',
          'bikeModel',
          'status',
          'openingDate',
          'expectedDate',
          'request',
          'servicesExecuted',
          'observation',
          'items',
          'merchandiseTotal',
          'servicesTotal',
          'discountTotal',
          'orderDiscountValue',
          'orderDiscountPercent',
          'total',
          'invoiced',
          'paymentMethod',
          'stockDeducted',
          'stockDeductedAt',
          'stockMovementBatchId',
          'updatedAt'
        ])
        && request.resource.data.status == 'Finalizado'
        && request.resource.data.invoiced == true
        && request.resource.data.paymentMethod in ['Debito', 'Credito', 'Pix', 'Dinheiro']
        && request.resource.data.stockDeducted == true
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 200
        && request.resource.data.merchandiseTotal is number
        && request.resource.data.merchandiseTotal > 0
        && request.resource.data.merchandiseTotal <= 10000000
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 10000000
        && request.resource.data.stockDeductedAt is string
        && request.resource.data.stockDeductedAt.size() <= 40
        && request.resource.data.stockMovementBatchId is string
        && request.resource.data.stockMovementBatchId.size() <= 200
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    function validOwnerCashLaunchStockUpdate(userId) {
      return isActiveOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(cashLaunchKeys())
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status',
          'items',
          'stockDeducted',
          'stockDeductedAt',
          'stockMovementBatchId',
          'deletedAt',
          'deletedBy',
          'deletedReason'
        ])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(cashFiscalFields())
        && request.resource.data.userId == userId
        && storedUserIdMatches(userId)
        && isText('orderNumber', 80)
        && isText('clientName', 120)
        && cashLaunchStatusValid()
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200
        && (
          request.resource.data.status == 'Em Lancamento'
          || (request.resource.data.items.size() > 0 && request.resource.data.merchandiseTotal > 0)
        )
        && isNumberInRange('merchandiseTotal', 0, 10000000)
        && isNumberInRange('servicesTotal', 0, 10000000)
        && isNumberInRange('discountTotal', 0, 10000000)
        && isNumberInRange('total', 0, 10000000)
        && request.resource.data.stockDeducted is bool
        && (
          request.resource.data.stockDeductedAt == null
          || (request.resource.data.stockDeductedAt is string && request.resource.data.stockDeductedAt.size() <= 40)
        )
        && (
          request.resource.data.stockMovementBatchId == null
          || (request.resource.data.stockMovementBatchId is string && request.resource.data.stockMovementBatchId.size() <= 200)
        )
        && isText('createdAt', 40)
        && isText('updatedAt', 40);
    }

    function validSettingsCreate(userId) {
      return isActiveOwner(userId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'whatsappTemplate',
          'oilTypes',
          'serviceTypes',
          'disabledDefaultServiceTypes',
          'businessEmail',
          'warrantyCategories',
          'businessName',
          'businessPhone',
          'businessWhatsapp',
          'businessInstagram',
          'businessAddress',
          'isProfileComplete',
          'expenses'
        ])
        && optionalUserIdMatches(userId);
    }

    function validSettingsUpdate(userId) {
      return isActiveOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userId',
          'whatsappTemplate',
          'oilTypes',
          'serviceTypes',
          'disabledDefaultServiceTypes',
          'businessEmail',
          'warrantyCategories',
          'businessName',
          'businessPhone',
          'businessWhatsapp',
          'businessInstagram',
          'businessAddress',
          'isProfileComplete',
          'expenses'
        ])
        && optionalUserIdMatches(userId);
    }

    function clientKeys() {
      return [
        'name',
        'fullName',
        'document',
        'bikeModel',
        'oilType',
        'oilPrice',
        'contact',
        'email',
        'vehiclePlate',
        'mileageKm',
        'lastMaintenanceDate',
        'nextMaintenanceDate',
        'recurrenceDays',
        'status',
        'isRecurringRevenue',
        'notificacao_enviada',
        'notificacaoStatus',
        'lastServiceType',
        'lastServiceValue',
        'lastServiceNotes',
        'userId',
        'createdAt',
        'lastAlertDate',
        'serviceValue',
        'statusPagamento',
        'valorPago',
        'saldoDevedor',
        'automation',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function maintenanceKeys() {
      return [
        'clientId',
        'clientName',
        'bikeModel',
        'date',
        'oilType',
        'oilPrice',
        'serviceType',
        'serviceValue',
        'isRecurringRevenue',
        'notes',
        'userId',
        'statusPagamento',
        'valorPago',
        'saldoDevedor',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function warrantyKeys() {
      return [
        'clientName',
        'serviceType',
        'serviceDescription',
        'serviceValue',
        'serviceDate',
        'durationMonths',
        'expiryDate',
        'clientPhone',
        'warrantyNumber',
        'userId',
        'createdAt',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function appointmentKeys() {
      return [
        'clientName',
        'bikeModel',
        'scheduledDate',
        'address',
        'serviceRequested',
        'value',
        'completed',
        'createdAt',
        'userId',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function expenseKeys() {
      return [
        'description',
        'supplier',
        'amount',
        'paymentMethod',
        'date',
        'note',
        'userId',
        'createdAt',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function productKeys() {
      return [
        'id',
        'sourceCode',
        'description',
        'variation',
        'variations',
        'ncm',
        'salePrice',
        'stockQuantity',
        'minStockQuantity',
        'trackStock',
        'importedAt',
        'userId',
        'createdAt',
        'updatedAt',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function cashLaunchKeys() {
      return [
        'orderNumber',
        'clientId',
        'clientName',
        'clientDocument',
        'clientEmail',
        'clientPhone',
        'bikeModel',
        'status',
        'openingDate',
        'expectedDate',
        'request',
        'servicesExecuted',
        'observation',
        'items',
        'merchandiseTotal',
        'servicesTotal',
        'discountTotal',
        'orderDiscountValue',
        'orderDiscountPercent',
        'total',
        'invoiced',
        'paymentMethod',
        'fiscalInvoiceId',
        'fiscalReference',
        'fiscalIssuedAt',
        'manualFiscal',
        'stockDeducted',
        'stockDeductedAt',
        'stockMovementBatchId',
        'userId',
        'createdAt',
        'updatedAt',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function stockMovementKeys() {
      return [
        'userId',
        'productId',
        'productDescription',
        'sourceCode',
        'variationId',
        'variation',
        'type',
        'quantity',
        'previousQuantity',
        'nextQuantity',
        'cashLaunchId',
        'cashLaunchOrderNumber',
        'itemIds',
        'batchId',
        'note',
        'createdAt'
      ];
    }

    function cashFiscalFields() {
      return ['fiscalInvoiceId', 'fiscalReference', 'fiscalIssuedAt'];
    }

    function messageLogKeys() {
      return [
        'clientId',
        'clientName',
        'bikeModel',
        'phone',
        'channel',
        'status',
        'trigger',
        'message',
        'createdAt',
        'sentAt',
        'error',
        'userId',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function operationalLogKeys() {
      return [
        'timestamp',
        'usuario',
        'userId',
        'oficina',
        'acao',
        'resultado',
        'targetId',
        'details'
      ];
    }

    function whatsappAutomationKeys() {
      return [
        'userId',
        'enabled',
        'aiEnabled',
        'autoReplyEnabled',
        'appointmentEnabled',
        'createdAt',
        'updatedAt'
      ];
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if validUserProfileCreate(userId) || isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && validOwnerAutoDeactivate());
      allow delete: if false;
    }

    match /users/{userId}/fiscal_private/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/fiscal_invoice_files/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/clients/{clientId} {
      allow read: if canReadUserData(userId);
      allow create: if isAdmin() || (validOwnerCreate(userId, clientKeys()) && clientShape(userId));
      allow update: if isAdmin() || (validOwnerUpdate(userId, clientKeys()) && clientShape(userId));
      allow delete: if false;
    }

    match /users/{userId}/maintenances/{maintenanceId} {
      allow read: if canReadUserData(userId);
      allow create: if isAdmin() || (validOwnerCreate(userId, maintenanceKeys()) && maintenanceShape(userId));
      allow update: if isAdmin() || (validOwnerUpdate(userId, maintenanceKeys()) && maintenanceShape(userId));
      allow delete: if false;
    }

    match /users/{userId}/warranties/{warrantyId} {
      allow read: if canReadUserData(userId);
      allow create: if isAdmin() || (validOwnerCreate(userId, warrantyKeys()) && warrantyShape(userId));
      allow update: if isAdmin() || (validOwnerUpdate(userId, warrantyKeys()) && warrantyShape(userId));
      allow delete: if false;
    }

    match /users/{userId}/appointments/{appointmentId} {
      allow read: if canReadUserData(userId);
      allow create: if isAdmin() || (validOwnerCreate(userId, appointmentKeys()) && appointmentShape(userId));
      allow update: if isAdmin() || (validOwnerUpdate(userId, appointmentKeys()) && appointmentShape(userId));
      allow delete: if false;
    }

    match /users/{userId}/expenses/{expenseId} {
      allow read: if canReadUserData(userId);
      allow create: if isAdmin() || (validOwnerCreate(userId, expenseKeys()) && expenseShape(userId));
      allow update: if isAdmin() || (validOwnerUpdate(userId, expenseKeys()) && expenseShape(userId));
      allow delete: if false;
    }

    match /users/{userId}/products/{productId} {
      allow read: if canReadUserData(userId);
      allow create: if isAdmin() || (validOwnerCreate(userId, productKeys()) && productShape(userId, productId));
      allow update: if validOwnerProductStockUpdate(userId) || isAdmin() || (validOwnerUpdate(userId, productKeys()) && productShape(userId, productId));
      allow delete: if false;
    }

    match /users/{userId}/stock_movements/{movementId} {
      allow read: if canReadUserData(userId);
      allow create: if validOwnerStockMovementCreate(userId) || isAdmin() || (validOwnerCreate(userId, stockMovementKeys()) && stockMovementShape(userId));
      allow update, delete: if false;
    }

    match /users/{userId}/cash_launches/{launchId} {
      allow read: if canReadUserData(userId);
      allow create: if isAdmin()
        || (
          validOwnerCreate(userId, cashLaunchKeys())
          && !request.resource.data.keys().hasAny(cashFiscalFields())
          && cashLaunchShape(userId)
        );
      allow update: if isAdmin()
        || validOwnerSoftDeleteUpdate(userId)
        || validOwnerCashLaunchFinalizedStockPaymentUpdate(userId)
        || validOwnerCashLaunchStockUpdate(userId)
        || (
          validOwnerUpdate(userId, cashLaunchKeys())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(cashFiscalFields())
          && cashLaunchUpdateShape(userId)
        );
      allow delete: if false;
    }

    match /users/{userId}/settings/{settingId} {
      allow read: if settingId == 'config' && canReadUserData(userId);
      allow create: if settingId == 'config' && (isAdmin() || (validSettingsCreate(userId) && settingsShape(userId)));
      allow update: if settingId == 'config' && (isAdmin() || (validSettingsUpdate(userId) && settingsShape(userId)));
      allow delete: if false;
    }

    match /users/{userId}/message_logs/{messageLogId} {
      allow read: if canReadUserData(userId);
      allow create: if isAdmin() || (validOwnerCreate(userId, messageLogKeys()) && messageLogShape(userId));
      allow update: if isAdmin() || (validOwnerUpdate(userId, messageLogKeys()) && messageLogShape(userId));
      allow delete: if false;
    }

    match /users/{userId}/operational_logs/{logId} {
      allow read: if canReadUserData(userId);
      allow create: if isAdmin() || isOwner(userId) || (validOwnerCreate(userId, operationalLogKeys()) && operationalLogShape(userId));
      allow update, delete: if false;
    }

    match /users/{userId}/whatsapp_sessions/{sessionId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/whatsapp_messages/{messageId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/whatsapp_contacts/{contactId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/whatsapp_automations/{automationId} {
      allow read: if canReadUserData(userId);
      allow create: if isAdmin() || (validOwnerCreate(userId, whatsappAutomationKeys()) && whatsappAutomationShape(userId));
      allow update: if isAdmin() || (validOwnerUpdate(userId, whatsappAutomationKeys()) && whatsappAutomationShape(userId));
      allow delete: if false;
    }

    match /users/{userId}/fiscal_companies/{companyId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/fiscal_invoices/{invoiceId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/fiscal_logs/{logId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

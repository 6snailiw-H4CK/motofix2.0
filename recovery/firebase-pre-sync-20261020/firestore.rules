    function validOwnerProductStockUpdate(userId) {
      return storedUserIdMatches(userId)
        && optionalUserIdMatches(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stockQuantity',
          'variations',
          'stockMovementId',
          'updatedAt'
        ])
        && request.resource.data.stockQuantity is number
        && request.resource.data.stockQuantity >= 0
        && request.resource.data.stockQuantity <= 10000000
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'stockQuantity',
            'variations',
            'stockMovementId'
          ])
          || validStockOperationPair(userId, resource.data.id, request.resource.data, false)
        );
    }

    function validOwnerProductDataUpdate(userId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(productKeys())
        && optionalUserIdMatches(userId)
        && storedUserIdMatches(userId)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'stockQuantity',
            'variations',
            'stockMovementId'
          ])
          || validStockOperationPair(userId, resource.data.id, request.resource.data, false)
        )
        && productShape(userId, resource.data.id);
    }

    function validStockOperationPair(userId, productId, productData, isCreate) {
      return productData.stockMovementId is string
        && productData.stockMovementId.size() <= 200
        && (
          isCreate
            || productData.stockMovementId != resource.data.get('stockMovementId', '')
        )
        && stockOperationDataPair(userId, productId, productData, isCreate);
    }

    function stockOperationDataPair(userId, productId, productData, isCreate) {
      let operationPath = /databases/$(database)/documents/users/$(userId)/stock_movements/$(productData.stockMovementId);
      let operation = getAfter(operationPath).data;
      let change = operation.changes[productId];
      return existsAfter(operationPath)
        && operation.userId == userId
        && operation.productIds is list
        && operation.productIds.hasAny([productId])
        && operation.changes is map
        && operation.changes.keys().hasAny([productId])
        && change.productId == productId
        && change.nextQuantity == productData.stockQuantity
        && change.nextVariations == productData.get('variations', [])
        && (
          isCreate
            ? change.previousQuantity == 0 && change.previousVariations == []
            : change.previousQuantity == resource.data.get('stockQuantity', 0)
              && change.previousVariations == resource.data.get('variations', [])
        );
    }

    function validOwnerStockMovementCreate(userId, movementId) {
      let productPath = /databases/$(database)/documents/users/$(userId)/products/$(request.resource.data.productIds[0]);
      let product = getAfter(productPath).data;
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'type',
          'batchId',
          'note',
          'createdAt',
          'productIds',
          'changes',
          'cashLaunchId',
          'cashLaunchOrderNumber',
          'itemIds'
        ])
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() > 0
        && request.resource.data.productIds.size() <= 200
        && request.resource.data.changes is map
        && request.resource.data.changes.keys().hasOnly(request.resource.data.productIds)
        && request.resource.data.changes.keys().hasAll(request.resource.data.productIds)
        && request.resource.data.userId == userId
        && request.resource.data.type in ['saida_os', 'estorno_os', 'entrada_manual', 'ajuste_manual']
        && request.resource.data.batchId is string
        && request.resource.data.batchId.size() <= 200
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && optionalText('note', 1000)
        && (!request.resource.data.keys().hasAny(['cashLaunchId'])
          || request.resource.data.cashLaunchId is string)
        && (!request.resource.data.keys().hasAny(['cashLaunchOrderNumber'])
          || request.resource.data.cashLaunchOrderNumber is string)
        && (!request.resource.data.keys().hasAny(['itemIds'])
          || (request.resource.data.itemIds is list && request.resource.data.itemIds.size() <= 200))
        && existsAfter(productPath)
        && product.stockMovementId == movementId;
    }


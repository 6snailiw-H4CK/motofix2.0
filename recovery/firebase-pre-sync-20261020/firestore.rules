        && request.resource.data.merchandiseTotal <= 10000000
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 10000000
        && cashLaunchPaymentValid()
        && (
          request.resource.data.stockDeducted == true
            ? request.resource.data.stockDeductedAt is string
              && request.resource.data.stockDeductedAt.size() <= 40
              && request.resource.data.stockMovementBatchId is string
              && request.resource.data.stockMovementBatchId.size() <= 200
            : request.resource.data.stockDeductedAt == null
              && request.resource.data.stockMovementBatchId == null
        )
        && request.resource.data.updatedAt is string

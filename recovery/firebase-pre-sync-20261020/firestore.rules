      return [
        'id',
        'sourceCode',
        'description',
        'variation',
        'variations',
        'ncm',
        'salePrice',
        'stockQuantity',
        'stockMovementId',
        'minStockQuantity',
        'trackStock',
        'importedAt',
        'userId',
        'createdAt',
        'updatedAt',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function cashLaunchKeys() {
      return [
        'orderNumber',
        'clientId',
        'clientName',
        'clientDocument',
        'clientEmail',
        'clientPhone',
        'bikeModel',
        'status',
        'openingDate',
        'expectedDate',
        'request',
        'servicesExecuted',
        'observation',
        'items',
        'merchandiseTotal',
        'servicesTotal',
        'discountTotal',
        'orderDiscountValue',
        'orderDiscountPercent',
        'total',
        'statusPagamento',
        'valorPago',
        'saldoDevedor',
        'paidAt',
        'invoiced',
        'paymentMethod',
        'fiscalInvoiceId',
        'fiscalReference',
        'fiscalIssuedAt',
        'manualFiscal',
        'stockDeducted',
        'stockDeductedAt',
        'stockMovementBatchId',
        'stockShortageItems',
        'userId',
        'createdAt',
        'updatedAt',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function stockMovementKeys() {
      return [
        'userId',
        'productId',
        'productDescription',
        'sourceCode',
        'variationId',
        'variation',
        'type',
        'quantity',
        'previousQuantity',
        'nextQuantity',
        'cashLaunchId',
        'cashLaunchOrderNumber',
        'itemIds',
        'batchId',
        'note',
        'createdAt'
      ];
    }

    function cashFiscalFields() {
      return ['fiscalInvoiceId', 'fiscalReference', 'fiscalIssuedAt'];
    }

    function messageLogKeys() {
      return [
        'clientId',
        'clientName',
        'bikeModel',
        'phone',
        'channel',
        'status',
        'trigger',
        'message',
        'createdAt',
        'sentAt',
        'error',
        'userId',
        'deletedAt',
        'deletedBy',
        'deletedReason',
        'resetAt',
        'resetId'
      ];
    }

    function operationalLogKeys() {
      return [
        'timestamp',
        'usuario',
        'userId',
        'oficina',
        'acao',
        'resultado',
        'targetId',
        'details'
      ];
    }

    function whatsappAutomationKeys() {
      return [
        'userId',
        'enabled',
        'aiEnabled',
        'autoReplyEnabled',
        'appointmentEnabled',
        'createdAt',
        'updatedAt'
      ];
    }

    match /access_requests/{userId} {
      allow get: if isActiveMasterAdmin();
      allow list: if isActiveMasterAdmin();
      allow create: if signedIn() && isValidAccessRequestCreate(userId);
      allow update: if isActiveMasterAdmin() && validAccessRequestTransition(userId);
      allow delete: if false;
    }

    match /access_decisions/{auditId} {
      allow create: if isActiveMasterAdmin()
        && request.resource.data.targetUid is string
        && validAccessDecisionAuditCreate(request.resource.data.targetUid, auditId);
      allow get, list: if isActiveMasterAdmin();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isActiveMasterAdmin();
      allow list: if false;
      allow create: if validUserProfileCreate(userId);
      allow update: if isActiveMasterAdmin() && validAccessProfileDecision(userId);
      allow delete: if false;
    }

    match /system/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/fiscal_private/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/fiscal_invoice_files/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/clients/{clientId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId) && validOwnerCreate(userId, clientCreateKeys()) && clientCreateShape(userId);
      allow update: if isActiveOwner(userId) && (
        validOwnerClientMaintenanceUpdate(userId)
        || (validOwnerUpdate(userId, clientKeys()) && clientShape(userId))
      );
      allow delete: if false;
    }

    match /users/{userId}/maintenances/{maintenanceId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId) && validOwnerCreate(userId, maintenanceKeys()) && maintenanceShape(userId);
      allow update: if isActiveOwner(userId) && (
        validOwnerSoftDeleteUpdate(userId)
        || (validOwnerUpdate(userId, maintenanceKeys()) && maintenanceShape(userId))
      );
      allow delete: if false;
    }

    match /users/{userId}/warranties/{warrantyId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId) && validOwnerCreate(userId, warrantyKeys()) && warrantyShape(userId);
      allow update: if isActiveOwner(userId) && validOwnerUpdate(userId, warrantyKeys()) && warrantyShape(userId);
      allow delete: if false;
    }

    match /users/{userId}/appointments/{appointmentId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId) && validOwnerCreate(userId, appointmentKeys()) && appointmentShape(userId);
      allow update: if isActiveOwner(userId) && validOwnerUpdate(userId, appointmentKeys()) && appointmentShape(userId);
      allow delete: if false;
    }

    match /users/{userId}/expenses/{expenseId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId) && validOwnerCreate(userId, expenseKeys()) && expenseShape(userId);
      allow update: if isActiveOwner(userId) && validOwnerUpdate(userId, expenseKeys()) && expenseShape(userId);
      allow delete: if false;
    }

    match /users/{userId}/products/{productId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId)
        && validOwnerCreate(userId, productKeys())
        && productShape(userId, productId)
        && validStockOperationPair(userId, productId, request.resource.data, true);
      allow update: if isActiveOwner(userId)
        && (validOwnerProductStockUpdate(userId) || validOwnerProductDataUpdate(userId));
      allow delete: if false;
    }

    match /users/{userId}/stock_movements/{movementId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId) && validOwnerStockMovementCreate(userId, movementId);
      allow update, delete: if false;
    }

    match /users/{userId}/cash_launches/{launchId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasOnly(cashLaunchKeys())
        && !request.resource.data.keys().hasAny(cashFiscalFields())
        && cashLaunchShape(userId);
      allow update: if isActiveOwner(userId) && (
          validOwnerSoftDeleteUpdate(userId)
          || validOwnerCashLaunchFinalizedStockPaymentUpdate(userId)
          || validOwnerCashLaunchFinalizedStockUpdate(userId)
          || validOwnerCashLaunchCanceledUpdate(userId)
          || validOwnerCashLaunchSimpleStatusUpdate(userId)
          || validOwnerCashLaunchStockRestoreUpdate(userId)
          || validOwnerCashLaunchStockUpdate(userId)
          || (
            validOwnerUpdate(userId, cashLaunchKeys())
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(cashFiscalFields())
            && cashLaunchUpdateShape(userId)
          )
        );
      allow delete: if false;
    }

    match /users/{userId}/settings/{settingId} {
      allow read: if settingId == 'config' && canReadUserData(userId);
      allow create: if settingId == 'config' && isActiveOwner(userId) && validSettingsCreate(userId) && settingsShape(userId);
      allow update: if settingId == 'config' && isActiveOwner(userId) && validSettingsUpdate(userId) && settingsShape(userId);
      allow delete: if false;
    }

    match /users/{userId}/message_logs/{messageLogId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId) && validOwnerCreate(userId, messageLogKeys()) && messageLogShape(userId);
      allow update: if isActiveOwner(userId) && validOwnerUpdate(userId, messageLogKeys()) && messageLogShape(userId);
      allow delete: if false;
    }

    match /users/{userId}/operational_logs/{logId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId) && validOwnerCreate(userId, operationalLogKeys()) && operationalLogShape(userId);
      allow update, delete: if false;
    }

    match /users/{userId}/whatsapp_sessions/{sessionId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/whatsapp_messages/{messageId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/whatsapp_contacts/{contactId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/whatsapp_automations/{automationId} {
      allow read: if canReadUserData(userId);
      allow create: if isActiveOwner(userId) && validOwnerCreate(userId, whatsappAutomationKeys()) && whatsappAutomationShape(userId);
      allow update: if isActiveOwner(userId) && validOwnerUpdate(userId, whatsappAutomationKeys()) && whatsappAutomationShape(userId);
      allow delete: if false;
    }

    match /users/{userId}/fiscal_companies/{companyId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/fiscal_invoices/{invoiceId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/fiscal_logs/{logId} {
      allow read: if canReadUserData(userId);
      allow write: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

